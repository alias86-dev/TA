[Help]
	{
	Line0 = CTRL+A|Select all units;
	Line1 = CTRL+B|Select all construction units except the Commander;
	Line2 = CTRL+C|Select the Commander;
	Line3 = CTRL+D|Destruct selected unit(s);
	Line4 = CTRL+F|Select all factories;
	Line5 = CTRL+P|Select all aircraft with weapons;
    Line6 = CTRL+R|Select all radar, radar & sonar jammers & sonar;
	Line7 = CTRL+W|Select all mobile units with weapons except Commander;
	Line8 = CTRL+S|Select all units currently on the screen;
	Line9 = CTRL+V|Select all aircraft;
	Line10 = CTRL+T|Select all tanks with weapons;
	Line11 = CTRL+J|Select all mobile flakkers (phalanx, etc);
	Line12 = CTRL+O|Select all nanolathe towers;
	Line13 = CTRL+G|Select all ground units;
	Line14 = CTRL+H|Select all hovercrafts with weapons;
    Line15 = CTRL+L|Select all armed defense structures (exc.AA);
	Line16 = CTRL+N|Select all naval units with weapons;
    Line17 = CTRL+I|Select all anti-air structures (Defender, Flakker);
	Line18 = CTRL+E|Select all torpedo launchers;
    Line19 = CTRL+X|Select all super weapons (silos, anti-nukes, berthas);
    Line20 = CTRL+Y|Select All Metal Making Structures That Uses Energy.
    Line21 = CTRL+K|Select all kbots with weapons;
    Line22 = CTRL+Z|Select all units of same type;
    Line23 = CTRL+1 - 9|Assign the currently selected units to a squad;
    Line24 = ALT+1 - 9|Select squad;
    Line25 = SHIFT|Hold down to queue up multiple commands;
    Line26 = ESC|Cancels the current command;
    Line27 = H|Share resources with another player;
    Line28 = K|Toggles selected unit's cloaking capabilities;
    Line29 = N|Scroll to the next unit off screen;
    Line30 = O|Select the Orders menu for the current unit;
    Line31 = S|Give a stop order (cancel previous orders);
    Line32 = T|Track the selected unit;
    Line33 = V|Toggles move orders;
    Line34 = 1 - 9|Select the menu for the current unit;
    Line35 = -|Reduce the game speed;
    Line36 = +|Increase the game speed;
    Line37 = , (comma)|Select the previous menu for that unit;
    Line38 = . (period)|Select the next menu for that unit;
    Line39 = ~ (tilde)|Toggle damage bars on the units;
    Line40 = TAB|Multiplayer options;
    Line41 = SPACEBAR|Activate the game status bar;
    Line42 = PAUSE|Pause the game;
    Line43 = CTRL+F9|Screen capture;
    Line44 = F1|Display information on selected unit;
    Line45 = F2|Display the Options menu;
    Line46 = F3|Selects the unit that last reported;
    Line47 = F4|Bring up the multiplayer scorecard;
    Line48 = F12|Clear all chat messages;
    Line49 = CTRL+F5 - F8|Applies a map bookmark at cursor location;
    Line50 = F5 - F8|Centers the screen on a map bookmark;
    }
